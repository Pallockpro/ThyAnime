# Copy to .env.local for local dev. EVERYTHING here is optional — the site works with none of it set.

# Your own ThyAnime server, offered as a 3rd player server. The site never needs it:
# if it's down, its button greys out and MegaPlay / FilmU keep working.
# Use "off" to remove it from the site completely.
NEXT_PUBLIC_THY_SERVER=https://api.thyanime.me

# FilmU anime embed URL. {id} = AniList id, {ep} = episode, {lang} = sub|dub.
# ⚠ Verify against https://embed.filmu.in (Anime tab) — see lib/servers.js.
# NEXT_PUBLIC_FILMU_ANI=https://embed.filmu.in/anime/{id}/{ep}/{lang}
# NEXT_PUBLIC_FILMU_MAL=

# YumeList API base (adapter is a stub until you fill in lib/yumelist.js)
# NEXT_PUBLIC_YUMELIST_API=

# Only for GitHub Pages *project* sites (https://USER.github.io/REPO); the workflow sets this automatically.
# NEXT_PUBLIC_BASE_PATH=/REPO
